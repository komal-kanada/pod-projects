# Copy to .env.local (never committed). Both values are server-only.

# Postgres connection for this app's own role (gpo_app), through Supabase's
# transaction pooler. The username is "<role>.<project-ref>". See README → Setup.
DATABASE_URL=postgres://gpo_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Gemini key. Use a key from a Google Cloud project separate from PrepSprint's,
# so eval runs here can't use up PrepSprint's quota.
GEMINI_API_KEY=
