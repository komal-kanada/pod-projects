{
  "name": "world-bank-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:setup": "tsx --env-file-if-exists=.env.local scripts/check-setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "parse": "tsx --env-file-if-exists=.env.local scripts/parse.ts",
    "tree": "tsx --env-file-if-exists=.env.local scripts/tree.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "activate": "tsx --env-file-if-exists=.env.local scripts/activate.ts",
    "ask": "tsx --env-file-if-exists=.env.local scripts/ask.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts"
  },
  "dependencies": {
    "@pod/ai": "workspace:*",
    "@pod/db": "workspace:*",
    "@pod/eval": "workspace:*",
    "@pod/rag": "workspace:*",
    "@pod/ui": "workspace:*",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "^0.0.10",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@pod/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
