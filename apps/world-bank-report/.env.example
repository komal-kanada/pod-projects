# Copy to .env.local (never committed). Both values are server-only.

# Postgres connection for this app's own role (worldbank_app), through
# Supabase's transaction pooler. Username is "<role>.<project-ref>".
DATABASE_URL=postgres://worldbank_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Gemini key — ideally from a Google Cloud project separate from PrepSprint's.
GEMINI_API_KEY=
