# Copy to .env.local (never committed). All values are server-only.

# Postgres connection for this app's own role (imac_app), via the transaction pooler.
DATABASE_URL=postgres://imac_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Gemini key — ideally from a Google Cloud project separate from PrepSprint's.
GEMINI_API_KEY=

# Optional — strategy X3: the same focused extraction with a stronger model.
# Leave empty to skip X3.
X3_MODEL=
